<?xml version="1.0" encoding="utf-8"?>
<!--
  Scrambled Net 2 — jeu de puzzle « désembrouille-réseau ».
  Dérivé de Scrambled Net (© 2007–2010 Ian Cameron Smith,
  © 2014 Michael Mueller), lui-même portage du jeu KDE KNetWalk.
  Licence GPL-2.0 (voir LICENSE).

  Permissions : INTERNET pour la vérification de mises à jour depuis
  GitHub Releases (page titre) ; REQUEST_INSTALL_PACKAGES pour
  l'installation de la mise à jour téléchargée — le joueur autorise
  une seule fois cette source dans les réglages Android, puis les
  mises à jour s'installent sans confirmation quand le système
  l'accepte.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- M6 : retour prédictif (Android 13+) — les retours depuis Aide et
         Records prévisualisent l'écran précédent. Les versions avant 13
         (minSdk 24) ignorent simplement l'attribut ; tools:targetApi le
         dit à lint, qui autrement le signale comme inutilisé sous 33. -->
    <application
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.ScrambledNet2"
        tools:targetApi="33">

        <!-- Page titre : point d'entrée du lanceur (icône, version,
             vérification de mise à jour, chargement de la partie
             sauvegardée), puis entrée automatique dans le jeu. -->
        <activity
            android:name=".TitleActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <activity
            android:name=".ScoresActivity"
            android:exported="false"
            android:label="@string/scores_title"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".HelpActivity"
            android:exported="false"
            android:label="@string/menu_help"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/menu_settings"
            android:parentActivityName=".MainActivity" />

        <!-- Langue par application (page Réglages, v3 du 14 nov.
             2026) : ce service ne TOURNE jamais, il ne porte que le
             marqueur d'auto-stockage d'appcompat. Avant Android 13,
             la bibliothèque y conserve la langue choisie et la
             réapplique au démarrage, avant tout affichage ; sur
             Android 13+, le réglage système « langue par
             application » la porte (localeConfig ci-dessus, qui
             déclare en et fr). Une seule source de vérité : la page
             Réglages écrit via AppCompatDelegate, jamais dans un
             fichier maison. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>

</manifest>
