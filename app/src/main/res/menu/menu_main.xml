<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Barre sans titre (activity_main.xml) : quatre boutons texte
         visibles (Material 3 : actions essentielles de l'écran), le
         reste dans le menu de débordement (⋮).

         « always » : jamais sacrifié, même sur écran étroit.
         « ifRoom » : replié automatiquement dans le débordement quand la
         largeur manque (écrans < 360dp, ou pendant la résolution quand
         le titre devient « Arrêter le solveur », plus large).

         « Indice » (always) porte un badge du plafond restant — titre
         posé dynamiquement dans onPrepareOptionsMenu ; à 0 (plafond
         épuisé ou désactivé), à partie résolue ou pendant le solveur,
         le bouton est grisé mais reste visible pour rappeler le
         réglage. « Outils » ouvre un popup (menu_tools.xml) qui porte
         « Résoudre » et « Démonstration », actions plus rares depuis
         le chantier « Aide à la résolution » (15 nov. 2026). -->

    <item
        android:id="@+id/menu_new"
        android:title="@string/menu_new"
        app:showAsAction="always" />

    <item
        android:id="@+id/menu_hint"
        android:title="@string/menu_hint"
        app:showAsAction="always" />

    <item
        android:id="@+id/menu_tools"
        android:title="@string/menu_tools"
        app:showAsAction="ifRoom" />

    <!-- Page unique « Réglages » (refonte du 13 nov. 2026) : les
         sous-menus en cascade (niveau, sons, animation) vivent
         désormais sur SettingsActivity, visible d'un coup d'œil —
         ce bouton ouvre la page. -->
    <item
        android:id="@+id/menu_settings"
        android:title="@string/menu_settings"
        app:showAsAction="ifRoom" />

    <!-- Items génériques et rares : débordement uniquement. -->
    <item
        android:id="@+id/menu_scores"
        android:title="@string/menu_scores"
        app:showAsAction="never" />

    <item
        android:id="@+id/menu_help"
        android:title="@string/menu_help"
        app:showAsAction="never" />

    <item
        android:id="@+id/menu_about"
        android:title="@string/menu_about"
        app:showAsAction="never" />

</menu>
