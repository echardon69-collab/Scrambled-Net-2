<?xml version="1.0" encoding="utf-8"?>
<!-- Main du glissement de démonstration : la même moufle que
     doigt.xml (mêmes noms « corps », mêmes coordonnées —
     validate_apprentissage épingle le tracé identique) PLUS la
     flèche de trajectoire « trajet » sous le poing, dessinée à
     mesure par la démo (trimPathEnd, nul au repos). Le doigt
     pointe vers le HAUT : FingerOverlay fait pointer à droite le
     glissement horizontal (rotation 90°, épinglée) ; le balayage
     réel, lui, vient de l'overlay. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <group android:name="corps" android:pivotX="24" android:pivotY="24">
        <path
            android:name="main"
            android:fillColor="#E6FFFFFF"
            android:strokeColor="#661A1A1A"
            android:strokeWidth="1.2"
            android:pathData="M19.5,30 C19.5,15 19.5,11 24,11 C28.5,11 28.5,15 28.5,30 C30,30.5 31.5,31.5 32.5,33 C34,35.5 34.5,39 33,41.5 C31,44.8 27.5,46 24,46 C20.5,46 17,44.8 15,41.5 C13.5,39 14,35.5 15.5,33 C16.5,31.5 18,30.5 19.5,30 Z" />
    </group>

    <!-- Flèche de trajectoire sous le poing, ouverte pour le trim. -->
    <group android:name="trajet">
        <path
            android:name="chevron_trajet"
            android:fillColor="#00000000"
            android:strokeColor="#99FFFFFF"
            android:strokeWidth="2"
            android:trimPathStart="0"
            android:trimPathEnd="0"
            android:pathData="M14,42 L24,36 L34,42" />
    </group>
</vector>
