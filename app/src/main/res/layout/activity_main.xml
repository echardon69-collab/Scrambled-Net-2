<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Pas de titre sur l'écran de jeu : Material 3 veut que la barre ne
         porte que le contexte de la page et 1 à 2 actions essentielles.
         Le nom du jeu reste visible sur le lanceur et dans À propos ; la
         largeur libérée (~170dp) accueille les boutons texte « Nouvelle
         partie », « Résoudre » et « Réglages » (menu_main.xml).
         Attention : setSupportActionBar remet le label de l'activité
         comme titre ; MainActivity le désactive via
         setDisplayShowTitleEnabled(false).
         Hauteur : wrap_content + minHeight. À hauteur fixe
         (?attr/actionBarSize = 56dp), le padding d'inset de barre d'état
         ajouté par EdgeToEdge.padSystemBars écraserait le contenu à
         14-25dp sur les écrans à grande découpe (titre rogné, boutons
         invisibles) ; ici la toolbar grandit pour absorber l'inset et son
         contenu garde au moins 56dp. -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:background="?attr/colorPrimary" />

    <!-- Barre d'état : coups, niveau, temps -->
    <LinearLayout
        android:id="@+id/status_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/status_moves"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <TextView
            android:id="@+id/status_skill"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceLabelLarge" />

        <TextView
            android:id="@+id/status_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:textAppearance="?attr/textAppearanceBodyMedium" />
    </LinearLayout>

    <!-- Le plateau ne descend jamais sous la barre de navigation ; la
         bande sous cette barre garde le fond du plateau (M6). -->
    <FrameLayout
        android:id="@+id/board_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/board_background">

        <net.chardons.netscramble2.ui.BoardView
            android:id="@+id/board_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

</LinearLayout>
