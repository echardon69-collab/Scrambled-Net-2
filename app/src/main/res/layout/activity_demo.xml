<?xml version="1.0" encoding="utf-8"?>
<!-- Démonstration (chantier Aide à la résolution) : plein écran, la
     vue du plateau occupe tout, sans toolbar ni barre d'état du jeu.
     L'indication « Touchez pour revenir » s'affiche ~4 secondes puis
     fond (DemoActivity.fadeTouchHint) ; TOUTE interaction referme
     l'activité — la partie du joueur n'a pas bougé. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/demo_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <net.chardons.netscramble2.ui.BoardView
        android:id="@+id/demo_board"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/demo_touch_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="32dp"
        android:background="@android:color/transparent"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:text="@string/demo_touch_return"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="?attr/colorOnSurface"
        android:alpha="0.8" />
</FrameLayout>
