<?xml version="1.0" encoding="utf-8"?>
<!--
  Page titre : plein écran au lancement, sans barre d'actions
  (TitleActivity). Le nom du jeu et la licence y vivent ; l'écran de
  jeu reste sans titre (décision du 2 nov. 2026).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingHorizontal="@dimen/screen_padding">

    <!-- Icône de lancement (grand format), nom du jeu et version -->
    <ImageView
        android:id="@+id/title_icon"
        android:layout_width="128dp"
        android:layout_height="128dp"
        android:contentDescription="@string/app_name"
        android:src="@drawable/ic_launcher_foreground" />

    <TextView
        android:id="@+id/title_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/app_name"
        android:textAppearance="?attr/textAppearanceDisplaySmall" />

    <TextView
        android:id="@+id/title_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="?attr/textAppearanceBodyMedium" />

    <!-- Licence et remerciements -->
    <TextView
        android:id="@+id/title_license"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="@string/title_license"
        android:textAppearance="?attr/textAppearanceBodySmall" />

    <!-- Progression : chargement de la partie sauvegardée, puis
         vérification de mise à jour, puis téléchargement de l'APK. -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/title_progress"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:trackCornerRadius="4dp" />

    <TextView
        android:id="@+id/title_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/title_loading"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceBodyMedium" />

    <!-- Choix proposé quand une mise à jour a été trouvée à temps :
         cachés sinon (entrée automatique dans le jeu). -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/update_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        android:text="@string/title_update_button" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/play_button"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        android:text="@string/title_play_button" />

</LinearLayout>
