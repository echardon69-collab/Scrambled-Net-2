    <string name="lesson_l1_b1">גע באריח כדי לסובב אותו רבע סיבוב. חבר את הרשת מהשרת אל המסוף.</string>
    <string name="lesson_l1_b2">המשך כך: כל אריח המחובר לשרת נדלק.</string>
    <string name="lesson_l1_b3">כל הכבוד, רשת פתורה! כך מנצחים כל משחק: מסובבים, מחברים, מדליקים.</string>
    <string name="lesson_l2_b1">שיטה: התחל מהשרת ועקוב אחר הכבלים המחוברים, משכן לשכן. סובב אריח כדי להתחיל.</string>
    <string name="lesson_l2_b2">לחיצה ארוכה על אריח שכוון נכון: הנעילה מגינה עליו מפני סיבוב ביש מזל.</string>
    <string name="lesson_l2_b3">המשך משכן לשכן עד לניצחון, נועל את מה שאתה בטוח בו.</string>
    <string name="lesson_l2_b4">הנעילה היא בעלת בריתך בלוחות גדולים: שמור על השיטה.</string>
    <string name="lesson_l3_b1">הרמז המכוון מצביע על אריח לתיקון (מסגרת ירוקה). גע ברמז.</string>
    <string name="lesson_l3_b2">הרמז המתקן מיישר את האריח וחותם אותו (נעילה סופית). גע ברמז.</string>
    <string name="lesson_l3_b3">פתור משחק במקומך, מהלך אחר מהלך; משחק שנפתר כך לעולם לא נספר לשיאים. גע בפתור.</string>
    <string name="lesson_l3_b4">העזרים נועדו לחלץ אותך ממבוי סתום, לא לשחק במקומך: אתה מחליט.</string>
    <string name="lesson_l4_b1">לוח אמן: הקצוות מתעטפים. הלוח הוא טורוס: הימין מתחבר לשמאל, העליון מתחבר לתחתון.</string>
    <string name="lesson_l4_b2">פתור אותו: לפחות כבל אחד חוצה את קצה הלוח כדי להתחבר מעבר לו.</string>
    <string name="lesson_l4_b3">הטורוס נוכח בכל רמה מאמן ואילך: חשוב על הלוח בלי קצוות.</string>
    <string name="lesson_l5_b1">רמת מטורף: חלק מהאריחים בלתי נראים. הסק את כיוונם משכניהם, ואז סובב אריח גלוי.</string>
    <string name="lesson_l5_b2">המשך כך: כל שכן מגביל את האריחים הנסתרים, רק הניצחון חושף הכול.</string>
    <string name="lesson_l5_b3">הרמז המתקן חושף אריח מוסתר: מהלך שמוצג, לעולם לא משוחק.</string>
    <string name="lesson_l6_b1">לוח אינסופי: טורוס של 40 x 40, ממוסגר על השרת. גלול את החלון סיבוב מלא אופקית, עד שתמצא את השרת שוב.</string>
    <string name="lesson_l6_b2">הלוח חוזר על עצמו לנצח: לעולם לא טבעת אפורה. עכשיו נסע אנכית, סיבוב מלא.</string>
    <string name="lesson_l6_b3">צבוט בשתי אצבעות כדי להתקרב ולהתרחק: החלון הוא המצלמה שלך, העולם נשאר כפי שהוא.</string>
    <string name="lesson_l6_b4">מצב אינסופי משוחק במצלמה: ללוח אין קצוות, רק חלונות.</string>
    <string name="lesson_l7_b1">רמת ריק: ערפל מסתיר את הלוח. כל חיבור דוחק את הערפל לאחור. סובב אריח גלוי.</string>
    <string name="lesson_l7_b2">המשך כך: כל חיבור שנכבש מאיר את הסביבה שמסביבו.</string>
    <string name="lesson_l7_b3">ערפל נכבש אריח אחר אריח: האור עוקב אחר הרשת.</string>
