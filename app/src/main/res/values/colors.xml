<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Palette de l'option A (dégradés d'origine) : le plateau en toile de
         fond des tuiles VectorDrawable. Couleurs validées dans l'aperçu. -->
    <color name="brand_primary">#00695C</color>
    <color name="brand_on_primary">#FFFFFF</color>

    <color name="board_background">#C9CED4</color>

    <!-- M2 : blips de données qui parcourent les câbles (parité de
         l'original : couleur pleine sur les cellules connectées, gris
         ailleurs), et « données » affichées sur les écrans des terminaux. -->
    <color name="blip_active">#FFEE58</color>
    <color name="blip_idle">#90A4AE</color>
    <color name="term_data">#00C853</color>

    <!-- Brouillard d'Infini (phase C) : tuile cachée — case sombre
         pleine, plus foncée que le fond du plateau, sans interaction. -->
    <color name="fog_cell">#39424D</color>

    <!-- Blink : bande diagonale qui balaie une tuile refusée ou la
         tuile gagnante. L'original la dessinait BLANCHE — sur son
         plateau sombre. Notre thème jour est clair (cellules vides
         #E6E6E6 -> #CFCFCF) : le blanc y serait invisible (retour
         UAT du 13 nov.) — la bande prend la couleur contrastée du
         thème : ardoise le jour, blanc la nuit. -->
    <color name="blink_band">#FF39424D</color>

    <!-- Icône de lancement : fond de l'icône adaptative (API 26+) et du
         repli API 24-25. Blanc opaque — les lanceurs ne laissent pas passer
         la transparence (un fond transparent s'affiche en noir sur
         OxygenOS/OnePlus). Le SVG source reste dessiné sur transparent. -->
    <color name="ic_launcher_background">#FFFFFFFF</color>
</resources>
