<?xml version="1.0" encoding="utf-8"?>
<!-- Langues de l'application (page Réglages, v3 du 14 nov. 2026 ;
     corse puis alsacien ajoutés le 16 nov. 2026, chantier traduction ;
     chinois simplifié ajouté le 18 nov. 2026, traduction
     expérimentale, relecture native en attente).
     Déclaré au manifeste par android:localeConfig : sur Android 13+,
     le réglage système « langue par application » propose exactement
     ces cinq langues. La base est l'anglais (values), le français,
     le corse et l'alsacien sont les traductions (values-fr,
     values-co, values-gsw-rFR, values-zh-rCN) ; la page Réglages force en ou fr
     via appcompat, ou suit le système — c'est ainsi que le corse
     et l'alsacien s'activent jusqu'au chantier « sélecteur de
     langue dynamique ». L'alsacien n'a pas de code Android propre :
     il est porté par la locale gsw-FR (alémanique de France). -->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="fr" />
    <locale android:name="co" />
    <locale android:name="gsw-FR" />
    <locale android:name="zh-CN" />
</locale-config>
