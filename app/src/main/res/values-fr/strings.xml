    <!-- Aide (niveaux Maître et Dément) -->
    <string name="help_master">Au niveau Maître, les bords du plateau se
        referment sur eux-mêmes : les cellules du bord droit se connectent à
        celles du bord gauche, et inversement. De même pour les bords haut et
        bas.</string>
    <string name="help_insane">Au niveau Dément, les bords du plateau se
        referment sur eux-mêmes : les cellules du bord droit se connectent à
        celles du bord gauche, et inversement. De même pour les bords haut et
        bas. Mais en plus, dans les cellules à 3 ou 4 connexions, les câbles
        sont invisibles. Bonne chance !</string>
