    <!-- Les niveaux de la famille Infini (Abîme, Néant) remplacent
         l'ancien réglage brouillard : il est désormais la marque du
         niveau Néant. -->

    <!-- Aide (niveaux spéciaux) -->
    <string name="help_master">Au niveau Maître, les bords du plateau se
        referment sur eux-mêmes : les cellules du bord droit se connectent à
        celles du bord gauche, et inversement. De même pour les bords haut et
        bas.</string>
    <string name="help_insane">Au niveau Dément, les bords du plateau se
        referment sur eux-mêmes : les cellules du bord droit se connectent à
        celles du bord gauche, et inversement. De même pour les bords haut et
        bas. Mais en plus, dans les cellules à 3 ou 4 connexions, les câbles
        sont invisibles. Bonne chance !</string>
    <string name="help_abyss">Au niveau Abîme, le plateau est infini : il
        couvre 40 par 40 cases et ses bords se referment sur eux-mêmes, si
        bien que le déplacement ne montre jamais de bord. En plus, dans les
        cases à 3 ou 4 connexions, les câbles sont invisibles. Bonne
        chance !</string>
    <string name="help_void">Au niveau Néant, le plateau est infini : il
        couvre 40 par 40 cases et ses bords se referment sur eux-mêmes. Dans
        les cases à 3 ou 4 connexions, les câbles sont invisibles. Et en
        plus, un brouillard masque les cases éloignées du réseau connecté au
        serveur : seuls les abords des cases connectées restent visibles.
        Bonne chance !</string>
